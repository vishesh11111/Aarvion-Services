# ==============================================================================
# Aarvion CRM — environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# The API validates every variable below at boot (apps/api/src/config/env.ts)
# and refuses to start on an invalid configuration. Fail fast beats fail weird.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# Public origin of the frontend. Used for the CORS allow-list.
# Comma-separate to allow multiple origins (e.g. preview deployments).
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# MongoDB
#
# ⚠ PASSWORD ENCODING — the mistake that costs people an afternoon.
#
# Characters that are reserved in a URI must be percent-encoded in the username
# and password, or the driver misreads where the credentials end:
#
#     @ -> %40     / -> %2F     : -> %3A     ? -> %3F     # -> %23
#
# Example: the password  Aa@89824249  must be written  Aa%4089824249
# Generate it reliably:  node -e "console.log(encodeURIComponent('your-password'))"
#
# The API detects an unencoded '@' at boot and tells you, rather than letting the
# driver fail with an unrelated DNS error.
#
# Always include the database name in the path (…/aarvion_crm), otherwise the
# driver silently connects to a database called "test".
# ------------------------------------------------------------------------------

# --- MongoDB Atlas (production / shared development) --------------------------
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/aarvion_crm?retryWrites=true&w=majority&appName=Cluster0

# --- Local MongoDB via docker-compose -----------------------------------------
# The compose stack runs a single-node replica set (transactions require one),
# so `?replicaSet=rs0&directConnection=true` is required.
# MONGODB_URI=mongodb://localhost:27017/aarvion_crm?replicaSet=rs0&directConnection=true

# Connection pool size PER PROCESS. The total across all API and worker replicas
# must stay under your cluster's connection limit — Atlas shared tiers are far
# lower than people expect. See docs/DEPLOYMENT.md for the arithmetic.
MONGO_POOL_SIZE=20

# ------------------------------------------------------------------------------
# Redis 7 — BullMQ job queues + response/AI cache + distributed rate limiting
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Auth / crypto
#
# Generate strong secrets:  openssl rand -base64 48
# Access and refresh secrets MUST differ — a leaked access secret must not be
# able to mint refresh tokens.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-value-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-openssl-rand-base64-48-value-32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# Cookie settings. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# AI — Google Gemini
#
# Get a key: https://aistudio.google.com/app/apikey
# If GEMINI_API_KEY is empty the app still runs: every AI feature degrades to a
# deterministic heuristic fallback and reports `degraded` in its response.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2

# Per-organization AI budget guardrails (rolling 24h window)
AI_DAILY_REQUEST_LIMIT=1000
AI_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Ingestion limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
IMPORT_BATCH_SIZE=500
IMPORT_WORKER_CONCURRENCY=4
AI_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Rate limiting (per IP for public routes, per user for authenticated routes)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# Frontend (apps/web)
#
# API_INTERNAL_URL is used server-side by the Next.js BFF proxy — inside
# docker-compose that is `http://api:4000`. NEXT_PUBLIC_APP_URL is the browser
# origin of the web app itself.
# ------------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Seed data (development only — `npm run db:seed`)
# ------------------------------------------------------------------------------
SEED_ORG_NAME=Acme Corporation
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=Password123!
SEED_LEAD_COUNT=250
